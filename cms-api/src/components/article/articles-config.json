{
  "collectionName": "components_article_articles_configs",
  "info": {
    "displayName": "articles-config"
  },
  "options": {},
  "attributes": {
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 100
    },
    "articleScope": {
      "type": "enumeration",
      "default": "all",
      "enum": [
        "all",
        "featured"
      ]
    },
    "sortBy": {
      "type": "enumeration",
      "default": "original_published_at",
      "enum": [
        "createdAt",
        "original_published_at"
      ]
    },
    "sortDirection": {
      "type": "enumeration",
      "default": "desc",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "companies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::company.company"
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category"
    },
    "excludedArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    }
  },
  "config": {}
}
